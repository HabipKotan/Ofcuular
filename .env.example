# LLM: GEMINI_API_KEY doluysa Gemini kullanılır; hiçbir anahtar yoksa sistem otomatik mock moda geçer
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Ücretsiz kota anahtar (proje) başına: başka Google hesaplarından ek anahtarlar eklenirse, biri dolunca otomatik diğerine geçilir
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# LLM_MODEL=gemini-3.5-flash
# Claude kullanmak isterseniz: LLM_PROVIDER=anthropic ve ANTHROPIC_API_KEY=...

# Gerçek ders dosyalarının (transkript.json, notlar.json, kayitlar/) klasörü.
# Boş bırakılırsa proje klasörü (app.py'nin yanı) kullanılır.
# GERCEK_VERI_KLASORU=

# Odak analizi
FOCUS_THRESHOLD=50
FOCUS_SMOOTHING_WINDOW=5
FOCUS_MIN_GAP=15
FOCUS_MERGE_GAP=8

# Yerel STT
WHISPER_MODEL=small
WHISPER_LANGUAGE=tr

# Mikrofon: boşsa Windows'un varsayılan mikrofonu. Numarayı bulmak için: python mikrofon_testi.py
# MIKROFON=

# Ses -> metin
# Öğretmenin sesini ayır (derste en çok konuşan kişi); başka sesler metne çevrilmez. Kapatmak için 0.
# OGRETMEN_SESI_AYRIMI=1
# Yanlış duyulan kelimeleri Gemini ile düzelt (ör. "bölük" -> "bölü"). Kapatmak için 0.
# TRANSKRIPT_DUZELT=1

# Kameranın aynı anda izleyeceği en fazla yüz (öğrenci sayısı için; büyük sınıfta artırın)
# KAMERA_MAX_YUZ=30
# Kamera önizleme penceresi: kucuk (varsayılan, sol alt köşe) | normal | kapali
# KAMERA_ONIZLEME=kucuk
# Yüz algılama: uzak (arka sıralar dahil, varsayılan) | yakin (eski hızlı yöntem, ~1.3 m)
# KAMERA_ALGILAMA=uzak
# İstenen kamera çözünürlüğü (kamera desteklemezse kendi en yakın değerini verir)
# KAMERA_GENISLIK=1280
# KAMERA_YUKSEKLIK=720
# Uzak modda yüz bulma güveni: düşürmek daha uzaktakileri yakalar ama yanlış algılamayı artırır
# KAMERA_YUZ_ESIK=0.6

# Öğretmen arayüzüne şifre koymak için (boşsa şifre sorulmaz)
# OGRETMEN_SIFRESI=
